# Bank86 is 3.3 V (schematic PDF page11, U1 E9/H10).
set_property PACKAGE_PIN D10 [get_ports {qsfp_modsel_n[0]}]
set_property PACKAGE_PIN D9 [get_ports {qsfp_reset_n[0]}]
set_property PACKAGE_PIN E11 [get_ports {qsfp_scl[0]}]
set_property PACKAGE_PIN F9 [get_ports {qsfp_sda[0]}]
set_property PACKAGE_PIN F10 [get_ports {qsfp_present_n[0]}]
set_property PACKAGE_PIN E10 [get_ports {qsfp_int_n[0]}]
set_property PACKAGE_PIN D11 [get_ports {qsfp_lpmode[0]}]
set_property PACKAGE_PIN J11 [get_ports {qsfp_modsel_n[1]}]
set_property PACKAGE_PIN G10 [get_ports {qsfp_reset_n[1]}]
set_property PACKAGE_PIN G11 [get_ports {qsfp_scl[1]}]
set_property PACKAGE_PIN J10 [get_ports {qsfp_sda[1]}]
set_property PACKAGE_PIN H9 [get_ports {qsfp_present_n[1]}]
set_property PACKAGE_PIN G9 [get_ports {qsfp_int_n[1]}]
set_property PACKAGE_PIN J9 [get_ports {qsfp_lpmode[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {qsfp_*}]
set_property SLEW SLOW [get_ports {qsfp_reset_n[*] qsfp_lpmode[*] qsfp_modsel_n[*]}]
set_property DRIVE 4 [get_ports {qsfp_reset_n[*] qsfp_lpmode[*] qsfp_modsel_n[*]}]
set_property PACKAGE_PIN F24 [get_ports {ddr_reset_n[0]}]
set_property PACKAGE_PIN AD23 [get_ports {ddr_reset_n[1]}]
set_property IOSTANDARD LVCMOS12 [get_ports {ddr_reset_n[*]}]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLNONE [current_design]
